APP_NAME=LandslideGuard NER API
APP_VERSION=0.1.0
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL connection URI from Supabase. Do not use the Supabase HTTPS project URL.
SUPABASE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Comma-separated frontend origins. Use the exact deployed origin in production.
CORS_ORIGINS=https://your-frontend.example.com

# Production databases should be initialized through the approved schema/bootstrap process.
AUTO_CREATE_TABLES=false
